class Solution{
    public int pivotIndex(int[] a){
       
        int total_sum=0;
        for(int i =0;i<a.length;i++)
            total_sum +=a[i];
        int left_sum=0;
        for(int i =0;i<a.length;i++){
            int right_sum = total_sum - left_sum-a[i];
            if(left_sum == right_sum)
                 return i;
        left_sum+=a[i];
           
        }
    return -1;  
    }
}
